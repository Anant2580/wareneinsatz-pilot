# Copy this file to .env (cp .env.example .env). Used by docker compose and by the app.
POSTGRES_DB=wareneinsatz
POSTGRES_USER=wareneinsatz
POSTGRES_PASSWORD=wareneinsatz

# The app talks to the database from docker-compose.yml, which listens on host port 5433.
DATABASE_URL=postgresql+psycopg://wareneinsatz:wareneinsatz@localhost:5433/wareneinsatz

# Database tests use their own database (created on the first start of the container).
# Leave it empty to skip the database tests.
TEST_DATABASE_URL=postgresql+psycopg://wareneinsatz:wareneinsatz@localhost:5433/wareneinsatz_test

# Step 5: reading PDFs and photos. Free and local by default: Ollama on this computer + Tesseract.
# Uncomment a line to change a default.
# LLM_API=ollama                       # or "openai" for any OpenAI-compatible server
# LLM_BASE_URL=http://localhost:11434
# LLM_MODEL=qwen3-vl:8b-instruct       # smaller and faster: qwen3-vl:4b-instruct
# READING_MODE=hybrid                  # text, vision or hybrid
# OCR_ENGINE=tesseract                 # or "none"
# OCR_LANGUAGES=deu+eng
# Only for a cloud API. Keep the key here, never in git:
# LLM_API_KEY=

# Step 6: ingredient matching. Embeddings come from the same Ollama server.
# EMBEDDING_MODEL=qwen3-embedding:0.6b
